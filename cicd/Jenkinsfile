    stage('Copy deploy file') {
      try {
        echo "Copy ci/cd code"
        sh """
            cp -rf ${workspace}/cicd/* ${workspace}/
        """
      } catch (Exception e) {
        //sendRocketChatNotification('FAILED', 'Copy deploy file', DEB_DEV_VERSION, currentBranch, gitCommitHash)
        throw e
      }
    }

    stage('Build DEB odns-api file and push repo') {
      try {
        withCredentials([
          string(credentialsId: 'e42d4904-c0ff-44c6-9f2a-a346d94b337a', variable: 'GIT_USER'),
          string(credentialsId: 'a03dbb73-9b5d-4a59-9233-3c45ca04946a', variable: 'GIT_TOKEN'),
          string(credentialsId: '4c4e8b79-3f41-43f5-92c1-240569058b79', variable: 'NEXUS_PASSWORD'),]) {
            sh """
              echo "set version to: ${DEB_DEV_VERSION}"
              sed -Ei "s|VERSION|${DEB_DEV_VERSION}|g" odns-api-admin/DEBIAN/control
              sed -Ei "s|VERSION|${DEB_DEV_VERSION}|g" odns-api-client/DEBIAN/control 
              docker build --no-cache \
                -t debian12-odns-api-base \
                -f Dockerfile \
                --build-arg GIT_TOKEN=${GIT_TOKEN} \
                --build-arg GIT_USER=cicd \
