      }
    }

    stage ('Final Cleanup') {
      try {
        cleanWs()
        sh """
          docker rmi -f debian12-odns-api-base || true
        """
        echo "Cleanup workspace"
        echo "Remove docker images"
      } catch (Exception e) {
        //sendRocketChatNotification('FAILED', 'Final Cleanup', DEB_DEV_VERSION, currentBranch, gitCommitHash)
        throw e
      }
    }

    sendFinalNotification('SUCCESS', DEB_DEV_VERSION, currentBranch, gitCommitHash)

  } catch (Exception e) {
    sendFinalNotification('FAILED', DEB_DEV_VERSION, currentBranch, gitCommitHash)
    currentBuild.result = 'FAILURE'
    throw e
  }
}
