//Set discard job
properties([[$class: 'BuildDiscarderProperty', strategy: [$class: 'LogRotator', artifactDaysToKeepStr: '7', artifactNumToKeepStr: '10', daysToKeepStr: '7', numToKeepStr: '10']]]);

def getGitCommitHash() {
  return sh (script: "git log -n 1 --pretty=format:'%h'", returnStdout: true)
}

def sendRocketChatNotification(String status, String stageName, String version = '', String branch = '', String commit = '') {
  withCredentials([
    string(credentialsId: 'b0f59eaf-1abb-4909-8827-1bb93cc890bd', variable: 'ROCKETCHAT_ID'),
    string(credentialsId: '8927b4cf-2c53-4ed8-bafb-9a407ab7b54b', variable: 'ROCKETCHAT_TOKEN')
  ]) {
    def emoji = ':x:'
    def project = 'ocn-dns'
    def appName = 'odns-api'
    def runningUser = sh(script: "whoami", returnStdout: true).trim()
    
    def jsonPayload = """
{
  "channel": "#dns1",
  "text": "**Deployment Error Alert** \\n ${emoji} **Project:** ${project}/${appName} \\n **Stage:** ${stageName} \\n **Running user:** ${runningUser} \\n **Branch:** ${branch ?: env.BRANCH_NAME ?: 'N/A'} \\n **Build:** #${env.BUILD_NUMBER} \\n **Version:** ${version ?: 'N/A'} \\n **Commit:** ${commit ?: 'N/A'} \\n **Job URL:** ${env.BUILD_URL} \\n **Status:** FAILED \\n **Error:** "
}
"""
    
    writeFile file: '/tmp/rocket_payload.json', text: jsonPayload
    
    sh '''#!/bin/bash
      set -x
      
      AUTH_HEADER="X-Auth-Token: ${ROCKETCHAT_TOKEN}"
      USER_HEADER="X-User-Id: ${ROCKETCHAT_ID}"
      
      echo "Sending notification to RocketChat..."
      
      RESPONSE=$(curl -w "\\nHTTP_CODE:%{http_code}" \
           -H "${AUTH_HEADER}" \
           -H "${USER_HEADER}" \
           -H "Content-type: application/json" \
           -d '@/tmp/rocket_payload.json' \
           https://chat.ocn.com.vn/api/v1/chat.postMessage)
      
      echo "Response: ${RESPONSE}"
      
      HTTP_CODE=$(echo "${RESPONSE}" | grep HTTP_CODE | cut -d':' -f2)
      echo "HTTP Status Code: ${HTTP_CODE}"
      
      if [ "${HTTP_CODE}" != "200" ]; then
        echo "ERROR: Failed to send notification. HTTP Code: ${HTTP_CODE}"
      else
        echo "SUCCESS: Notification sent successfully"
      fi
      
      rm -f /tmp/rocket_payload.json
    '''
  }
}

def sendFinalNotification(String status, String version, String branch, String commit) {
  withCredentials([
    string(credentialsId: 'b0f59eaf-1abb-4909-8827-1bb93cc890bd', variable: 'ROCKETCHAT_ID'),
    string(credentialsId: '8927b4cf-2c53-4ed8-bafb-9a407ab7b54b', variable: 'ROCKETCHAT_TOKEN')
  ]) {
    def emoji = status == 'SUCCESS' ? ':white_check_mark:' : ':x:'
    def project = 'ocn-dns'
    def appName = 'odns-api'
    def runningUser = sh(script: "whoami", returnStdout: true).trim()
    def previousBuild = currentBuild.previousBuild?.number ?: 'N/A'
    def statusText = status == 'SUCCESS' ? 'Done, Access API http://172.18.206.18:8080/api/v1 to check' : 'Failed!'
    
    def jsonPayload = """
{
  "channel": "#dns1",
  "text": "**Final Deployment Report** \\n ${emoji} **Project:** ${project}/${appName} \\n **Running user:** ${runningUser} \\n **Branch:** ${branch} \\n **Version:** ${version} \\n **Commit:** ${commit} \\n **Description:** Built and deployed DEB packages from branch ${branch} \\n **Rollback plan:** Build #${previousBuild} available for rollback if needed \\n **Job URL:** ${env.BUILD_URL} \\n **Status:** ${statusText}"
}
"""
    
    writeFile file: '/tmp/rocket_payload.json', text: jsonPayload
    
    sh '''#!/bin/bash
      set -x
      
      AUTH_HEADER="X-Auth-Token: ${ROCKETCHAT_TOKEN}"
      USER_HEADER="X-User-Id: ${ROCKETCHAT_ID}"
      
      echo "Sending final notification to RocketChat..."
      
      RESPONSE=$(curl -w "\\nHTTP_CODE:%{http_code}" \
           -H "${AUTH_HEADER}" \
           -H "${USER_HEADER}" \
           -H "Content-type: application/json" \
           -d '@/tmp/rocket_payload.json' \
           https://chat.ocn.com.vn/api/v1/chat.postMessage)
      
      echo "Response: ${RESPONSE}"
      
      HTTP_CODE=$(echo "${RESPONSE}" | grep HTTP_CODE | cut -d':' -f2)
      echo "HTTP Status Code: ${HTTP_CODE}"
      
      if [ "${HTTP_CODE}" != "200" ]; then
        echo "ERROR: Failed to send notification. HTTP Code: ${HTTP_CODE}"
      else
        echo "SUCCESS: Notification sent successfully"
      fi
      
      rm -f /tmp/rocket_payload.json
    '''
  }
}

