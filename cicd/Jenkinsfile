        throw e
      }
    }

    stage('Deploy to testing') {
      try {
        echo "Ansible deploy testing"
        withCredentials([
            sshUserPrivateKey(credentialsId: '0469e31f-7353-4bab-8a11-5de71186c90c', keyFileVariable: 'CICD_PRIVATE_KEY'),
            string(credentialsId: 'aa3978dd-c262-427c-8d49-9274578596b8', variable: 'ANSIBLE_VAULT_PASSWORD')
        ]) {
            sh """
              # Create a temporary vault password file
              echo "\${ANSIBLE_VAULT_PASSWORD}" > /tmp/ansible_vault_password
              chmod 600 /tmp/ansible_vault_password
              # Run Ansible playbook
              export ANSIBLE_HOST_KEY_CHECKING=False
              ansible-playbook --private-key=\${CICD_PRIVATE_KEY} \
              -i cicd/deploy/inventories/testing/hosts cicd/deploy/site.yml \
              -l ocn-odns \
              --vault-password-file=/tmp/ansible_vault_password \
              --extra-vars VERSION=${DEB_DEV_VERSION}
