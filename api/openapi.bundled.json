{
  "openapi": "3.0.3",
  "info": {
    "title": "OCN-DNS-API API",
    "description": "dns api server endpoints",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/v1/ping": {
      "get": {
        "summary": "Health check endpoint",
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vms/{id}/prometheus/{metricType}": {
      "get": {
        "summary": "Get VM monitor by metricType with prometheus",
        "operationId": "getMonitorVMWithProm",
        "tags": [
          "vms"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "vm id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "metricType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/VMMetricType"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get VM monitor by metricType",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Monitor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse401"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse403"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse404"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse500"
          }
        }
      }
    },
    "/api/v1/vms/{id}/victoriametrics/{metricType}": {
      "get": {
        "summary": "Get VM monitor by metricType with victoriametrics",
        "operationId": "getMonitorVMWithVM",
        "tags": [
          "vms"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "vm id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "metricType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/VMMetricType"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get VM monitor by metricType",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Monitor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse401"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse403"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse404"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse500"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "Paging": {
        "type": "object",
        "x-go-type": "dto.Paging",
        "required": [
          "page",
          "limit",
          "from",
          "to",
          "total",
          "totalPage"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "format": "int"
          },
          "limit": {
            "type": "integer",
            "format": "int"
          },
          "from": {
            "type": "integer",
            "format": "int"
          },
          "to": {
            "type": "integer",
            "format": "int"
          },
          "total": {
            "type": "integer",
            "format": "int"
          },
          "totalPage": {
            "type": "integer",
            "format": "int"
          },
          "next": {
            "type": "string"
          },
          "prev": {
            "type": "string"
          }
        }
      },
      "PagingRequest": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int"
          },
          "limit": {
            "type": "integer",
            "format": "int"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "value": {}
        }
      },
      "VMMetricType": {
        "type": "string",
        "enum": [
          "cpu",
          "diskBytes",
          "diskOps",
          "memory",
          "networkBits",
          "networkPackets"
        ]
      },
      "Monitor": {
        "type": "object",
        "x-go-type": "dto.Monitor",
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "step": {
            "type": "integer",
            "format": "int64"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonitorTarget"
            }
          }
        }
      },
      "MonitorTarget": {
        "type": "object",
        "x-go-type": "dto.MonitorTarget",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MonitorTargetData"
          },
          "legendFormat": {
            "type": "string"
          }
        }
      },
      "MonitorTargetData": {
        "type": "object",
        "x-go-type": "dto.MonitorTargetData",
        "properties": {
          "timestamps": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "ErrorResponse400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "bad_request": {
                "summary": "Invalid request",
                "value": {
                  "error": {
                    "code": 4000,
                    "message": "Missing required field"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse401": {
        "description": "Common error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "unauthorized": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4003,
                    "message": "Required authentication"
                  }
                }
              },
              "unauthorized_token_invalid": {
                "summary": "unauthorized token invalid",
                "value": {
                  "error": {
                    "code": 4004,
                    "message": "Required authentication"
                  }
                }
              },
              "unauthorized_require_2fa": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4005,
                    "message": "Required 2fa authentication"
                  }
                }
              },
              "unauthorized_verify_2fa": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4006,
                    "message": "Invalid code"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse403": {
        "description": "Common error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "forbidden": {
                "summary": "Permission deny",
                "value": {
                  "error": {
                    "code": 4002,
                    "message": "Permission deny"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse404": {
        "description": "Common error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "bad_request": {
                "summary": "Invalid request",
                "value": {
                  "error": {
                    "code": 4001,
                    "message": "Resource not found"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse500": {
        "description": "Common error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "internal_error": {
                "summary": "internal error",
                "value": {
                  "error": {
                    "code": 5000,
                    "message": "Internal connection failed"
                  }
                }
              },
              "database_error": {
                "summary": "database error",
                "value": {
                  "error": {
                    "code": 5001,
                    "message": "Database connection failed"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
