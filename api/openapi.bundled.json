  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "Zone": {
        "type": "object",
        "x-go-type": "dto.Zone",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64",
            "x-omitempty": false
          },
          "organizationID": {
            "type": "integer",
            "format": "uint64",
            "x-omitempty": false
          },
          "name": {
            "type": "string",
            "description": "name of domain (ex: 'example.com.')",
            "x-omitempty": false
          },
          "type": {
            "type": "string"
          },
          "dnsSec": {
            "type": "boolean",
            "x-omitempty": false
          },
          "soaType": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateZoneRequest": {
        "type": "object",
        "required": [
          "name",
          "type",
          "soaType",
          "organizationID",
          "isTemplate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "x-oapi-codegen-extra-tags": {
              "validate": "required,fqdn"
            }
          },
          "type": {
            "type": "string"
          },
          "soaType": {
            "type": "string"
          },
          "isTemplate": {
            "type": "boolean"
          },
          "organizationID": {
            "type": "integer",
            "format": "uint64"
          }
        }
      },
      "UpdateZoneRequest": {
        "type": "object",
        "description": "update zone for admin",
        "properties": {
          "type": {
            "type": "string",
            "x-go-type-skip-optional-pointer": false
          },
          "soaType": {
            "type": "string",
            "x-go-type-skip-optional-pointer": false
          },
          "dnssec": {
            "type": "boolean",
            "x-go-type-skip-optional-pointer": false
          }
        }
      },
      "UpdateZoneClientRequest": {
        "type": "object",
        "description": "update zone for client",
        "properties": {
          "dnssec": {
            "type": "boolean",
            "x-go-type-skip-optional-pointer": false
          }
        }
      },
      "SOAType": {
        "type": "string",
        "x-go-type": "dto.SOAType",
        "enum": [
          "NONE",
          "DEFAULT",
          "INCREASE",
          "EPOCH",
          "OFF"
        ]
      },
      "Type": {
        "type": "string",
        "x-go-type": "dto.Type",
        "enum": [
          "None",
          "Native",
          "Primary",
          "Secondary"
        ]
      },
      "Organization": {
        "type": "object",
        "x-go-type": "dto.Organization",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64",
            "x-omitempty": false
          },
          "name": {
            "type": "string",
            "x-omitempty": false
          },
          "description": {
            "type": "string",
            "x-omitempty": false
          },
          "contact": {
            "type": "string",
            "x-omitempty": false
          },
          "email": {
            "type": "string",
            "x-omitempty": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Paging": {
        "type": "object",
        "x-go-type": "dto.Paging",
        "required": [
          "page",
          "limit",
          "from",
          "to",
          "total",
          "totalPage"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "format": "int"
          },
          "limit": {
            "type": "integer",
            "format": "int"
          },
          "from": {
            "type": "integer",
            "format": "int"
          },
          "to": {
            "type": "integer",
            "format": "int"
          },
          "total": {
            "type": "integer",
            "format": "int"
          },
          "totalPage": {
            "type": "integer",
            "format": "int"
          },
          "next": {
            "type": "string"
          },
          "prev": {
            "type": "string"
          }
        }
      },
      "PagingRequest": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int"
          },
          "limit": {
            "type": "integer",
            "format": "int"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "value": {}
        }
      },
      "CreateOrgRequest": {
        "type": "object",
        "required": [
          "name",
          "contact",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "x-oapi-codegen-extra-tags": {
              "validate": "required,max=255"
            }
          },
          "description": {
            "type": "string"
          },
          "contact": {
            "type": "string",
            "maxLength": 255,
            "x-oapi-codegen-extra-tags": {
              "validate": "required,max=255"
            }
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "x-oapi-codegen-extra-tags": {
              "validate": "required,max=255"
            }
          }
        }
      },
      "ListOrganizationResponse": {
        "type": "object",
        "properties": {
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          }
        }
      },
      "UpdateOrgRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "x-go-type-skip-optional-pointer": false
          },
          "contact": {
            "type": "string",
            "maxLength": 255,
            "x-oapi-codegen-extra-tags": {
              "validate": "required,max=255"
            },
            "x-go-type-skip-optional-pointer": false
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "x-oapi-codegen-extra-tags": {
              "validate": "required,max=255"
            },
            "x-go-type-skip-optional-pointer": false
          }
        }
      },
      "ListZoneResponse": {
        "type": "object",
        "x-go-type": "dto.ListZoneResponse",
        "properties": {
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Zone"
            }
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          }
        }
      }
    },
    "responses": {
      "ErrorResponse400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "bad_request": {
                "summary": "Invalid request",
                "value": {
                  "error": {
                    "code": 4000,
                    "message": "Missing required field"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse401": {
        "description": "Common error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "unauthorized": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4003,
                    "message": "Required authentication"
                  }
                }
              },
              "unauthorized_token_invalid": {
                "summary": "unauthorized token invalid",
                "value": {
                  "error": {
                    "code": 4004,
                    "message": "Required authentication"
                  }
                }
              },
              "unauthorized_require_2fa": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4005,
                    "message": "Required 2fa authentication"
                  }
                }
              },
              "unauthorized_verify_2fa": {
                "summary": "unauthorized",
                "value": {
                  "error": {
                    "code": 4006,
                    "message": "Invalid code"
                  }
                }
              }
            }
